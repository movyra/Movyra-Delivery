rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // GLOBAL DENY
    // Strictly block all access by default to prevent data leaks.
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // IN-DEVELOPMENT WAITLIST REGISTRATIONS (NEW ADDITION)
    // ========================================================================
    match /pre_registrations/{document} {
      // Allow public create access so anyone can join the waitlist
      allow create: if true;
      
      // Strictly restrict read, update, and delete access to the 3 authorized Admin UIDs only
      // WARNING: Replace the placeholder strings with the actual UIDs from your Firebase Auth Console
      allow read, update, delete: if request.auth != null && request.auth.uid in [
        'oGZkaJTtkISgYS3UyQKhhxANWFa2', 
        '8zAyPwFZZBfU7MD1NkBDDWbIzXt1', 
        'REr2KNUjOmWOsUxuvq3YtmlkJsB3'
      ];
    }

    // ========================================================================
    // MOVYRA PITCH DECK LIVE SECTIONS (Existing)
    // ========================================================================

    // 1. Live Vendor Onboarding & Early Tester Signups
    match /vendor_applications/{document} {
      allow create: if request.resource.data.keys().hasAll(['businessName', 'contactPhone', 'timestamp', 'status']);
      allow read: if true; // Allowed for live real-time counters
      allow update, delete: if false; 
    }

    // 2. Live Investor QnA Board
    match /investor_questions/{document} {
      allow create: if request.resource.data.keys().hasAll(['question', 'timestamp', 'votes']);
      // Allow public read and allowing anyone to upvote (update) a question
      allow read, update: if true; 
      allow delete: if false;
    }

    // 3. Real-Time Feedback Module
    match /platform_feedback/{document} {
      allow create: if request.resource.data.keys().hasAll(['rating', 'comment', 'timestamp']);
      allow read: if true; // Allowed to show live average ratings
      allow update, delete: if false;
    }

    // 4. Live Coverage Map Nodes (Operational Zones)
    match /operational_nodes/{document} {
      // Public can only view the live nodes on the map. Only backend admins can write.
      allow read: if true;
      allow write: if false;
    }

    // 5. Real-Time Partner Stats (Live Telemetry)
    match /live_telemetry/{document} {
      // Public can view live stats (active drivers, total deliveries today)
      allow read: if true;
      allow write: if false; // Only backend scripts update this telemetry
    }


    // ========================================================================
    // ONBOARDING / EARLY ACCESS (Existing)
    // ========================================================================
    match /early_access/{document} {
      // Public write restricted to having required fields
      allow create: if request.resource.data.name != null 
                    && request.resource.data.phone != null;
      // Public read allowed for real-time counters on the frontend
      allow read: if true;
      // Nobody can modify or delete from frontend
      allow update, delete: if false; 
    }

    // ========================================================================
    // ISOLATED APP ENVIRONMENT (Existing Multi-Tenant Structure)
    // All API data is securely scoped within artifacts/appId/ path.
    // ========================================================================
    match /artifacts/{appId} {

      match /users/{userId} {
        // 1. Grant access to the root user identity document
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // 2. Grant access to ALL nested private data (orders, addresses, profile)
        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /public/data {
        // Driver transparency profiles are read-only for authenticated customers
        match /drivers/{driverId} {
          allow read: if request.auth != null;
          allow write: if false;
        }

        // System telemetry logs are strictly append-only
        match /system_logs/{logId} {
          allow create: if true; 
          allow read, update, delete: if false;
        }
      }
    }

    // ========================================================================
    // GROCERY MODULE ONBOARDING PROFILES (NEW ADDITION)
    // ========================================================================
    match /grocery_profiles/{userId} {
      // Resolves the 403 Permission Denied error during the Orchestrator boot sequence
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================================================
    // LEGACY ROOT COLLECTIONS (Existing Bridge for Migration)
    // Allows existing orders and data to remain accessible during transition.
    // ========================================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Keep existing legacy rules below unchanged...
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        !('userId' in resource.data)
      );
    }

    match /saved_addresses/{addressId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    match /bids/{bidId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    match /shipments/{shipmentId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    match /disputes/{disputeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

  }
}