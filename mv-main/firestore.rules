rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // GLOBAL SECURITY DEFINITIONS & ACCESS CONTROL
    // ========================================================================
    
    // Hardcoded Admin Verification
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'oGZkaJTtkISgYS3UyQKhhxANWFa2', 
        '8zAyPwFZZBfU7MD1NkBDDWbIzXt1', 
        'REr2KNUjOmWOsUxuvq3YtmlkJsB3'
      ];
    }

    // ========================================================================
    // GLOBAL DENY
    // Strictly block all access by default to prevent data leaks.
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // IN-DEVELOPMENT WAITLIST REGISTRATIONS
    // ========================================================================
    match /pre_registrations/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ========================================================================
    // MOVYRA PITCH DECK LIVE SECTIONS (Existing)
    // ========================================================================

    // 1. Live Vendor Onboarding & Early Tester Signups
    match /vendor_applications/{document} {
      allow create: if request.resource.data.keys().hasAll(['businessName', 'contactPhone', 'timestamp', 'status']);
      allow read: if true; 
      allow update, delete: if isAdmin(); 
    }

    // 2. Live Investor QnA Board
    match /investor_questions/{document} {
      allow create: if request.resource.data.keys().hasAll(['question', 'timestamp', 'votes']);
      allow read, update: if true; 
      allow delete: if isAdmin();
    }

    // 3. Real-Time Feedback Module
    match /platform_feedback/{document} {
      allow create: if request.resource.data.keys().hasAll(['rating', 'comment', 'timestamp']);
      allow read: if true; 
      allow update, delete: if isAdmin();
    }

    // 4. Live Coverage Map Nodes (Operational Zones)
    match /operational_nodes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Real-Time Partner Stats (Live Telemetry)
    match /live_telemetry/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ========================================================================
    // ONBOARDING / EARLY ACCESS (Existing)
    // ========================================================================
    match /early_access/{document} {
      allow create: if request.resource.data.name != null && request.resource.data.phone != null;
      allow read: if true;
      allow update, delete: if isAdmin(); 
    }

    // ========================================================================
    // ISOLATED APP ENVIRONMENT (Existing Multi-Tenant Structure)
    // ========================================================================
    match /artifacts/{appId} {
      match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
        }
      }

      match /public/data {
        match /drivers/{driverId} {
          allow read: if request.auth != null;
          allow write: if isAdmin();
        }
        match /system_logs/{logId} {
          allow create: if true; 
          allow read, update, delete: if isAdmin();
        }
      }
    }

    // ========================================================================
    // DEDICATED SHOPPER ACCOUNTS (VEGGIES & DAILY NEEDS STOREFRONTS)
    // ========================================================================
    match /shopper_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
    }

    // ========================================================================
    // GROCERY MODULE ONBOARDING PROFILES 
    // ========================================================================
    match /grocery_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
    }

    // ========================================================================
    // E-COMMERCE PUBLIC CATALOGS & USER STATE (UPDATED FOR VENDORS)
    // ========================================================================
    match /promotions/{promoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == storeId) || isAdmin();
    }
    
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update: if (request.auth != null && request.resource.data.storeId == request.auth.uid) || isAdmin();
      allow delete: if (request.auth != null && resource.data.storeId == request.auth.uid) || isAdmin();
    }

    match /user_carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
    }

    // ========================================================================
    // LEGACY ROOT COLLECTIONS (Existing Bridge for Migration)
    // ========================================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.storeId == request.auth.uid || 
        !('userId' in resource.data) ||
        isAdmin()
      );
    }

    match /saved_addresses/{addressId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null || isAdmin();
    }

    match /bids/{bidId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null || isAdmin();
    }

    match /shipments/{shipmentId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null || isAdmin();
    }

    match /disputes/{disputeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null || isAdmin();
    }

  }
}